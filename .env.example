# Resend API key for contact form email
RESEND_API_KEY=

# Cloudflare Turnstile secret key for spam protection
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key (public, used in frontend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Site URL (used for canonical URLs and OG images)
NEXT_PUBLIC_SITE_URL=https://tayyab.co
